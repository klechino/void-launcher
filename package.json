{
  "name": "void-launcher",
  "version": "1.0.0",
  "description": "A premium Minecraft launcher with Void Client",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Void",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:react\"",
    "dev:react": "react-scripts start",
    "dev:electron": "electron .",
    "build": "react-scripts build && npm run build:electron",
    "build:electron": "tsc src/main/main.ts --outDir dist && tsc src/preload/preload.ts --outDir dist",
    "pack": "electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "discord-rpc": "^4.0.1",
    "electron-squirrel-startup": "^1.1.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "file-saver": "^2.0.5",
    "jsdom": "^22.0.0",
    "jzz": "^1.10.6",
    "node-cache": "^5.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.voidlauncher.app",
    "productName": "Void Launcher",
    "directories": {
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/void-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Void Launcher"
    }
  }
}
